# ════════════════════════════════════════════════════════════════════════════
# .gitignore — Files to exclude from Git version control
# ════════════════════════════════════════════════════════════════════════════

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ── Secrets & Environment Variables ──────────────────────────────────────────
# NEVER commit real API keys or credentials to Git
.env
.env.*
!.env.example

# ── SQLite Database Files ────────────────────────────────────────────────────
# Checkpoint state is runtime data, not source code
*.db
*.sqlite
*.sqlite3
checkpoints.db

# ── Python Cache & Bytecode ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Testing & Coverage Artifacts ─────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ── IDE & Editor Configuration ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Helm Build Artifacts ─────────────────────────────────────────────────────
helm/k8s-copilot/charts/
helm/k8s-copilot/Chart.lock
*.tgz
