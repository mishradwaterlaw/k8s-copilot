# ════════════════════════════════════════════════════════════════════════════
# .env.example — Template for your .env file
# ════════════════════════════════════════════════════════════════════════════
# Copy this to .env and fill in your values:
#   cp .env.example .env
#
# .env is listed in .gitignore — NEVER commit real API keys to git.
# .env.example has no real values — safe to commit.
# ════════════════════════════════════════════════════════════════════════════

# ── LLM Configuration ────────────────────────────────────────────────────────
# Get your Gemini API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Which Gemini model to use (gemini-2.5-flash is fast and cost-effective)
LLM_MODEL=gemini-2.5-flash

# LLM temperature — 0 for deterministic analysis (recommended)
LLM_TEMPERATURE=0

# ── Data Provider ─────────────────────────────────────────────────────────────
# "fixture" → use hardcoded test data (no cluster needed, for demos)
# "kube_api" → use real Kubernetes API (requires cluster access)
DATA_PROVIDER=fixture

# ── Kubernetes (only needed when DATA_PROVIDER=kube_api) ──────────────────────
# Path to your kubeconfig file (default: ~/.kube/config)
# KUBECONFIG=~/.kube/config

# Default namespace to investigate
KUBE_NAMESPACE=default

# ── Investigation Settings ────────────────────────────────────────────────────
# Max investigation loops before forcing human review
MAX_ITERATIONS=3

# Confidence threshold to stop looping (0.75 = 75%)
CONFIDENCE_THRESHOLD=0.75

# Where to store the SQLite checkpoint database
CHECKPOINT_DB_PATH=checkpoints.db
